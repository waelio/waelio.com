{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./public",
    "rootDir": "./src",
    "rewriteRelativeImportExtensions": true,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/app.ts",
    "src/login.ts",
    "src/private.ts",
    "src/service-worker.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
