{
  "name": "waelio.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "waelio.com – Package stats site",
  "scripts": {
    "build:web": "tsc -p tsconfig.web.json && tsx scripts/build-react-web.ts",
    "build": "pnpm run build:web",
    "dev": "tsx scripts/dev.ts",
    "pages:dev": "pnpm run build:web && npx wrangler pages dev public --kv=WAELIO_PRIVATE --compatibility-date=2024-12-01 --compatibility-flags=nodejs_compat",
    "start": "pnpm run build:web && tsx server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@waelio/agent": "^0.1.3",
    "@waelio/data": "^1.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "waelio-utils": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260510.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.90.0"
  }
}