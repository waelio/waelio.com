{
  "name": "waelio.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "waelio.com – Package stats site",
  "scripts": {
    "build:web": "tsc -p tsconfig.web.json && tsx scripts/build-private-react.ts",
    "build": "pnpm run build:web",
    "dev": "tsx scripts/dev.ts",
    "start": "pnpm run build:web && tsx server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "waelio-utils": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}