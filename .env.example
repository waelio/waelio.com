# Copy to .env and fill with your values
SITE_ID="YOUR_SITE_ID"
SITE_NAME="YOUR_SITE_NAME"

# Google-only auth
AUTH_SECRET="replace-with-a-random-secret-string"
GOOGLE_CLIENT_ID="your-google-oauth-web-client-id.apps.googleusercontent.com"
# Comma-separated emails allowed to access /private via Google Sign-In
ALLOWED_EMAILS="you@example.com,partner@example.com"
