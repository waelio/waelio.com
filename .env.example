# Copy to .env and fill with your values
# These are also set in Cloudflare Pages dashboard → Settings → Environment variables

# Google-only auth
AUTH_SECRET="replace-with-a-random-secret-string"
LEDGER_SECRET="replace-with-a-second-random-secret-string"
GOOGLE_CLIENT_ID="your-google-oauth-web-client-id.apps.googleusercontent.com"
# Comma-separated emails allowed to access /private via Google Sign-In
ALLOWED_EMAILS="you@example.com,partner@example.com"

# Optional private agent defaults
# Leave AGENT_API_BASE_URL blank if you prefer to set your backend URL in the browser.
AGENT_API_BASE_URL="http://localhost:8000"
AGENT_APP_NAME="Agent"

# Optional Cloudflare R2 / S3 credentials
# If you want to store files in R2 via the S3 API or native bucket bindings,
# set the values below in your local env or Cloudflare Pages environment.
R2_ACCOUNT_ID="f8e411adbc0ac8c96ac4e00beaacd9cd"
R2_BUCKET_NAME="your-bucket-name"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://f8e411adbc0ac8c96ac4e00beaacd9cd.r2.cloudflarestorage.com"
